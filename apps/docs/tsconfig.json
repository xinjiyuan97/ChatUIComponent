{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Re-declared, because `paths` replaces rather than merges — and `baseUrl` must move
     * with it, since the inherited one points at the repo root. */
    "baseUrl": ".",
    "paths": {
      "@xinjiyuan97/core": ["../../packages/core/src/index.ts"],
      "@xinjiyuan97/a2ui": ["../../packages/a2ui/src/index.ts"],
      "@xinjiyuan97/ui": ["../../packages/ui/src/index.ts"],
      "@xinjiyuan97/ui/a2ui-registry": ["../../packages/ui/src/a2ui-registry/index.ts"]
    }
  },
  "include": ["src", ".storybook"]
}
