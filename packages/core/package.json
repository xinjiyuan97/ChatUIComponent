{
  "name": "@xinjiyuan97/core",
  "version": "0.1.0",
  "description": "Headless state, streaming transports and hooks for agent chat UIs.",
  "license": "MIT",
  "keywords": [
    "chat",
    "ai",
    "agent",
    "llm",
    "streaming",
    "react",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinjiyuan97/ChatUIComponent.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/xinjiyuan97/ChatUIComponent#readme",
  "bugs": "https://github.com/xinjiyuan97/ChatUIComponent/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zustand": "^5.0.2"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^19.0.0"
  }
}
