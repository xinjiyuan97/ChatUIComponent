{
  "name": "@xinjiyuan97/chat-ui",
  "version": "0.2.0",
  "description": "Beautiful, minimal React components for agent chat interfaces.",
  "license": "MIT",
  "keywords": [
    "chat",
    "chat-ui",
    "ai",
    "agent",
    "llm",
    "react",
    "components",
    "tailwind",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinjiyuan97/ChatUIComponent.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/xinjiyuan97/ChatUIComponent#readme",
  "bugs": "https://github.com/xinjiyuan97/ChatUIComponent/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./a2ui-registry": {
      "types": "./dist/a2ui-registry.d.ts",
      "import": "./dist/a2ui-registry.js",
      "require": "./dist/a2ui-registry.cjs"
    },
    "./tokens.css": "./src/styles/tokens.css",
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && pnpm build:css",
    "build:css": "tailwindcss -i src/styles/build.css -o dist/style.css --minify",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xinjiyuan97/chat-a2ui": "workspace:*",
    "@xinjiyuan97/chat-core": "workspace:*",
    "clsx": "^2.1.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "shiki": "^1.24.2",
    "tailwind-merge": "^2.5.5"
  },
  "peerDependencies": {
    "docx-preview": "^0.3.0",
    "exceljs": "^4.4.0",
    "mermaid": "^10.9.0 || ^11.0.0",
    "pdfjs-dist": "^4.0.0 || ^5.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "docx-preview": {
      "optional": true
    },
    "exceljs": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "docx-preview": "^0.3.3",
    "exceljs": "^4.4.0",
    "mermaid": "^11.4.1",
    "pdfjs-dist": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  }
}
